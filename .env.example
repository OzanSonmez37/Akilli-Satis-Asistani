# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi girin.
# .env dosyası .gitignore içindedir, GitHub'a yüklenmez.

FLASK_ENV=development
SECRET_KEY=buraya-uzun-rastgele-bir-deger-yazin
DATABASE_URL=sonmez_turizm.db

# Groq anahtarı (gsk_... ile başlar). Boş bırakılırsa asistan "demo modu"nda çalışır.
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b

# Virgülle ayrılmış izinli kökenler (Wix sitenizin adresi). Geliştirmede * kullanılabilir.
CORS_ORIGINS=*
# Canlıda (Wix sitesi + Wix önizleme adresleri; * içeren değerler regex olarak eşleşir):
# CORS_ORIGINS=https://ozansonmez2004.wixstudio.com,https://.*\.editor\.wix\.com$,https://.*\.filesusr\.com$
